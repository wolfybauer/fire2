[sub_resource type="GDScript" id="GDScript_61eh1"]
script/source = "@tool
extends RigidBody3D

@export var health:int = 100
@export var persistence:float = 1.0
@export var size:Vector3 = Vector3.ONE
@export var items:Array[PackedScene] = []

@onready var fire_component: FireComponent3D = $FireComponent
@onready var destronoi: DestronoiNode = $Destronoi

const SMOKE_PUFF = preload(\"res://gde_test/assets/fire/smoke_puff.tscn\")

func _ready() -> void:
	var mesh:MeshInstance3D
	var col:CollisionShape3D
	for n in get_children(true):
		if n is MeshInstance3D:
			mesh = n
		if n is CollisionShape3D:
			col = n
		if col and mesh: break
	
	if mesh: mesh.scale = size
	if col and col.shape is BoxShape3D:
		(col.shape as BoxShape3D).size = size
	mass = size.x * size.y * size.z * max(mass, 10.0) 
	
	if not Engine.is_editor_hint():
		destronoi.persistence = persistence
		fire_component.damage.connect(func(d):apply_damage(d))

func apply_damage(amt:int, dir:Vector3=Vector3.ZERO):
	apply_central_impulse(dir*amt)
	health -= amt
	if health <= 0:
		var puff:GPUParticles3D = SMOKE_PUFF.instantiate()
		get_parent().add_child(puff)
		puff.add_to_group('fade_obj')
		puff.global_position = global_position
		puff.visible = false
		puff.emitting = true
		if not items.is_empty():
			for i in items:
				var item = i.instantiate()
				get_parent().add_child(item)
				(item as Node3D).global_position = global_position
				
		destronoi.destroy(2.0, dir*amt)
		
"

